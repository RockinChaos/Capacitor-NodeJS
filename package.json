{
  "name": "capacitor-nodejs",
  "version": "1.0.0-beta.12",
  "description": "A full-fledged Node.js runtime for Capacitor apps",
  "type": "module",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/libnode/bin/arm64-v8a/libnode.so",
    "android/libnode/bin/armeabi-v7a/libnode.so",
    "android/libnode/bin/x86_64/libnode.so",
    "android/libnode/include/",
    "android/build.gradle",
    "android/CMakeLists.txt",
    "assets/",
    "dist/",
    "ios/Plugin/",
    "CapacitorNodejs.podspec"
  ],
  "author": "RockinChaos",
  "contributors": [
    "Rene Hampölz (https://github.com/hampoelz)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RockinChaos/capacitor-nodejs.git"
  },
  "bugs": {
    "url": "https://github.com/RockinChaos/capacitor-nodejs/issues"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native"
  ],
  "scripts": {
    "verify": "npm run verify:ios && npm run verify:android && npm run verify:web",
    "verify:ios": "cd ios && pod install && xcodebuild -workspace Plugin.xcworkspace -scheme Plugin && cd ..",
    "verify:android": "node scripts/extract-libnode.mjs && cd android && ./gradlew clean build test && cd .. && node scripts/cleanup-libnode.mjs",
    "verify:web": "npm run build",
    "verify:ci": "npm run verify:android && npm run verify:web",
    "lint": "npm run eslint && npm run prettier -- --check && npm run swiftlint -- lint",
    "lint:ci": "npm run eslint && npm run prettier -- --check",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write && npm run swiftlint -- autocorrect --format",
    "eslint": "eslint . --ext ts",
    "prettier": "prettier \"**/*.{css,html,ts,js,java}\" --plugin=prettier-plugin-java",
    "swiftlint": "node-swiftlint",
    "docgen": "docgen --api NodeJSInterface --output-readme README.md --output-json dist/docs.json",
    "build-bridge": "tsc --project bridge/tsconfig.json && rollup -c bridge/rollup.config.mjs && rimraf ./bridge/build",
    "build": "npm run clean && tsc && rollup -c rollup.config.mjs && npm run build-bridge",
    "clean": "rimraf ./dist ./build",
    "watch": "tsc --watch",
    "prepack": "mkdirp build && node scripts/extract-libnode.mjs",
    "postpack": "node scripts/cleanup-libnode.mjs",
    "pack:bridge": "cd assets/types/bridge && npm pack --pack-destination ../ && node ../../../scripts/pack-bridge.mjs",
    "pack": "npm run pack:bridge && npm pack --pack-destination build/",
    "prepublishOnly": "npm run build",
    "release": "npm run clean && npm run docgen && npm run build"
  },
  "devDependencies": {
    "@capacitor/android": "8.0.0",
    "@capacitor/cli": "8.0.0",
    "@capacitor/core": "8.0.0",
    "@capacitor/docgen": "^0.3.1",
    "@capacitor/ios": "8.0.0",
    "@ionic/prettier-config": "^4.0.0",
    "@ionic/swiftlint-config": "^2.0.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "mkdirp": "^3.0.1",
    "prettier": "^3.8.3",
    "prettier-plugin-java": "^2.9.7",
    "rimraf": "^6.1.3",
    "rollup": "^4.61.1",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-dts": "^6.4.1",
    "swiftlint": "^2.0.0",
    "typescript": "^5.9.3",
    "unzipper": "^0.12.3"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "prettier": "@ionic/prettier-config",
  "swiftlint": "@ionic/swiftlint-config",
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended"
    ],
    "rules": {
      "@typescript-eslint/no-explicit-any": "off",
      "@typescript-eslint/no-this-alias": "off"
    }
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  }
}
